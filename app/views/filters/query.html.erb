<div class="my-4 d-flex align-items-center text-success gap-1">
  <h1 class="mb-0 d-inline">
    <%= t('filters.query_title', filter: @filter.name, table: @filter.table.name.pluralize) %>
  </h1>
</div>

<div class="border rounded bg-white shadow-xs p-2 p-sm-4">
  <%= form_tag query_filter_path, method: :get do %>
    <div class="row row-cols-sm-2 row-cols-lg-4 gap-1">
    <% @filter.table.fields.where.not(datatype: 'QRCode').ordered.each_with_index do |field, index| %>
      <div class="row">
        <div class="col px-auto">
          <% has_input_group = !(field.datatype == "Oui_non?" || field.Signature? || field.Date?) %>
          <label class="fw-bold mb-1 <%= 'd-flex gap-1 align-items-center' unless has_input_group %>">
            <% unless has_input_group %>
              <span class="material-symbols-outlined text-black-50">
                <%= field.icon %>
              </span>
            <% end %>
            <%= field.name.humanize %>
          </label>
          <% if field.is_numeric %>
            <div class="input-group">
              <%= filter_icon_addon(field) %>
              <%= text_field_tag "[query][#{field.id}]", params["[query]"].try(:[], field.id.to_s), class: 'form-control border-start-0 ps-0', autofocus: index.zero? %>
            </div>
            <% hint = t('filters.numeric_hint') %>
          <% elsif field.Date? %>
            <div>
              <div class="input-group flex-row flex-nowrap mb-2">
                <span class="input-group-text text-secondary justify-content-center" style="min-width: 50px;"><%= t('tables.navbar.from') %></span>
                <%= date_field_tag "[query][#{field.id}][start]", params["[query]"].try(:[], field.id.to_s).try(:[], :start), class: 'form-control w-100', autofocus: index.zero? %>
              </div>
              <div class="input-group flex-row flex-nowrap">
                <span class="input-group-text text-secondary justify-content-center" style="min-width: 50px;"><%= t('tables.navbar.to') %></span>
                <%= date_field_tag "[query][#{field.id}][end]", params["[query]"].try(:[], field.id.to_s).try(:[], :end), class: 'form-control w-100' %>
              </div>
            </div>
            <% hint = t('filters.date_hint') %>
          <% elsif field.Liste? %>
            <div class="input-group">
              <%= filter_icon_addon(field, 'align-items-start pt-2') %>
              <%= select_tag "[query][#{field.id}]", options_for_select(field.items_splitted, params["[query]"].try(:[], field.id.to_s)), class: 'form-select border-start-0 ps-0', autofocus: index.zero?, multiple: true %>
            </div>
            <% hint = t('misc.select_hint') %>
          <% elsif field.Collection? %>
            <%# Checker si la liste vient d'une autre table %>
            <% if field.is_valid_table_params %>
              <div class="input-group">
                <%= filter_icon_addon(field, 'align-items-start pt-2') %>
                <%= select_tag "[query][#{field.id}]", options_for_select(field.populate_linked_table.invert, params["[query]"].try(:[], field.id.to_s)), class: 'form-select border-start-0 ps-0 overflow-x-auto', autofocus: index.zero?, multiple: true %>
              </div>
              <% hint = t('misc.select_hint') %>
            <% end %>
          <% elsif field.Statut? %>
            <% items = field.items_splitted.map{|e| e.split(':')}.to_h %>
            <div class="input-group">
              <%= filter_icon_addon(field, 'align-items-start pt-2') %>
              <%= select_tag "[query][#{field.id}]", options_for_select(items.keys, params["[query]"].try(:[], field.id.to_s)), class: 'form-select border-start-0 ps-0', 'data-testid': field.name, autofocus: index.zero?, multiple: true %>
            </div>
            <% hint = t('misc.select_hint') %>
          <% elsif field.datatype == "Oui_non?" || field.Signature? %>
            <div class="mt-2">
              <%= label_tag "[query][#{field.id}][yes]", t('misc.Oui'), class: 'me-1' %>
              <%= check_box_tag "[query][#{field.id}][yes]", params["[query]"].try(:[], field.id.to_s).try(:[], :yes), params["[query]"].try(:[], field.id.to_s).try(:[], :yes) %>
              <%= label_tag "[query][#{field.id}][no]", t('misc.Non'), class: 'ms-3 me-1' %>
              <%= check_box_tag "[query][#{field.id}][no]", params["[query]"].try(:[], field.id.to_s).try(:[], :no), params["[query]"].try(:[], field.id.to_s).try(:[], :no) %>
            </div>
          <% elsif field.Stars? %>
            <div class="input-group">
              <%= filter_icon_addon(field) %>
              <%= select_tag "[query][#{field.id}]", options_for_select((0..5).to_a, params["[query]"].try(:[], field.id.to_s)), class: 'form-select border-start-0 ps-0', include_blank: true, autofocus: index.zero? %>
            </div>
            <% hint = t('filters.star_hint') %>
          <% else %>
            <div class="input-group">
              <%= filter_icon_addon(field) %>
              <%= text_field_tag "[query][#{field.id}]", params["[query]"].try(:[], field.id.to_s), class: 'form-control border-start-0 ps-0', autofocus: index.zero? %>
            </div>
            <% hint = t('filters.text_hint') %>
          <% end %>
          <p class="form-text">
            <%= hint %>
          </p>
        </div>
      </div>
    <% end %>
    </div>
    
    <%= submit_tag t('filters.save_query'), class: 'btn btn-outline-success' %>
  <% end %>
</div>

<% if @records %>
  <ul class="nav nav-tabs w-100 mt-4">
    <li class="nav-item shadow-xs">
      <div class="nav-link fw-bold active">
        <%= @filter.table.name.pluralize.humanize %> > <%= @filter.name %>
      </div>
    </li>
  </ul>

  <div class="card shadow-xs p-3">
    <%= render partial: 'partials/table', locals: { table: @filter.table, records: @records} %>
  </div>
<% end %>