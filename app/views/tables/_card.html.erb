<%= link_to details_table_path(@table, record_index: record_index), title: t('tables.details'), class: 'text-reset text-decoration-none', 'data-testid': "Voir ligne n°#{record_index}", data: { turbo_frame: "_top" } do %>
  <div class="shadow p-4 bg-white flex-fill">
    <p class="fw-bold">
      <% first_field = @table.fields.first %>
      <% data = first_field.values.find_by(record_index: record_index).data %>
      <% if first_field.Date? %>
        <% data = l(data.to_date) %>
      <% end %>
      <%= data %>
    </p>
    
    <% values = @table.value_datas_détaillable(record_index) %>
    <% @table.fields.détaillable.ordered.each_with_index do |field, index| %>
      <% next if index.zero? %>
      <br>

      <% if value = values[index] %>
        <%= render FieldValueComponent.new(field: field, value: value, table: @table, record_index: record_index, context: :card) %>
      <% end %>
    <% end %>
  </div>
<% end %>