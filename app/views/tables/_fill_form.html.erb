<div class="<%= aperçu ? 'phone-content' : 'border rounded shadow-xs p-3 p-sm-4' %>">
  <div class="<%= aperçu ? 'px-1' : 'row row-cols-sm-2 row-cols-lg-3' %>">
    <% values_map = @record_index.present? ? @table.values.where(record_index: @record_index).index_by(&:field_id) : {} %>
    <% @table.fields.ordered.each_with_index do |field, index| %>
      <%= render FieldInputComponent.new(
            field: field,
            table: @table,
            record_index: @record_index,
            value: values_map[field.id]&.data,
            index: index,
            relation_param: params[:relation],
            value_param: params[:value]
          ) %>
    <% end %>
  </div>

  <% if aperçu && @table.fields.count.zero? %>
    <p class="mt-4 px-1"><%= t('tables.no_attribute') %></p>
  <% end %>
  <div class="d-flex flex-wrap align-items-center gap-2 mt-4 <%= aperçu ? 'px-1' : '' %>">
    <%= submit_tag t('scaffold.submit'), id: 'submit', class: 'btn btn-outline-primary' %>
    <% if params[:record_index].blank? %>
      <%= submit_tag t('scaffold.submit_and_refill'), name: 'submit_and_refill', class: 'btn btn-outline-primary' %>
    <% end %>
    <%= link_to_unless aperçu, t('scaffold.cancel'), table_path(@table) %>
  </div>
</div>